spring:
  application:
    name: haizhuo-brain-server
  lifecycle:
    timeout-per-shutdown-phase: 30s
  jackson:
    default-property-inclusion: non_null
    time-zone: Asia/Shanghai
server:
  port: 8080
  shutdown: graceful
haizhuo:
  brain:
    agent:
      provider: dashscope
      primary-model: qwen-plus
management:
  opentelemetry:
    resource-attributes:
      service.name: ${haizhuo.brain.observability.langfuse.service-name:${LANGFUSE_SERVICE_NAME:${OTEL_SERVICE_NAME:haizhuo-brain}}}
  tracing:
    sampling:
      probability: ${HAIZHUO_BRAIN_TRACE_SAMPLE_PROBABILITY:1.0}
  otlp:
    tracing:
      export:
        enabled: ${LANGFUSE_ENABLED:false}
      endpoint: ${LANGFUSE_OTLP_TRACES_ENDPOINT:http://172.16.1.29:3001/api/public/otel/v1/traces}
      transport: http
